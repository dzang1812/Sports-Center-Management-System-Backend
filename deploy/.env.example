# Copy to /var/www/sportscenter-api/.env on the EC2 instance (never commit the real file).
# One KEY=VALUE per line. Nested config keys use __ (double underscore).

ConnectionStrings__Default=Host=aws-0-ap-northeast-1.pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.ncgotulhylqopvgekruf;Password=REPLACE_ME;SSL Mode=Require
Jwt__Key=REPLACE_ME_long_random_string
# Manager may toggle scheduling/check-in time guards for all roles on this API instance.
# Start with normal time enforcement after every service restart; set AllowGlobalSwitch=false to disable the control.
Flow2TimeRules__AllowGlobalSwitch=true
Flow2TimeRules__EnforceTimeRules=true
PayOs__ClientId=REPLACE_ME
PayOs__ApiKey=REPLACE_ME
PayOs__ChecksumKey=REPLACE_ME
Smtp__Host=smtp.gmail.com
Smtp__Username=REPLACE_ME@gmail.com
Smtp__Password=REPLACE_ME_app_password
# FE's real deployed URL, once known — without it, the browser blocks the FE from calling this API.
Cors__AllowedOrigins__0=https://REPLACE_ME_frontend_domain
Cloudinary__CloudName=REPLACE_ME
Cloudinary__ApiKey=REPLACE_ME
Cloudinary__ApiSecret=REPLACE_ME
# AI features (chat, plan builder, image/video/session analysis). Members need an active subscription.
# Video form analysis needs ffmpeg on the server: sudo apt-get install -y ffmpeg
OpenAI__ApiKey=REPLACE_ME
# Optional: hard monthly spend cap in USD and per-member daily limits (defaults: 20 / 100 / 5 / 15 / 5).
AiUsage__MonthlyBudgetUsd=20

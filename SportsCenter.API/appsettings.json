{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "SportsCenter.API",
    "Audience": "SportsCenter.Client",
    "ExpiryMinutes": 480
  },
  "Scheduling": {
    "ClassCancellationCutoffHours": 12,
    "PtCancellationCutoffHours": 12,
    "AllowLateClassCancellation": true,
    "AllowLatePtCancellation": true,
    "ClassBookingOpensDaysBefore": null,
    "ClassBookingClosesMinutesBefore": 0,
    "PtBookingOpensDaysBefore": null,
    "PtBookingClosesMinutesBefore": 0
  }
}
